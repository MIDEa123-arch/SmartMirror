    {
        "id": "page-event-dedup",
        "type": "function",
        "z": "f680d3f76342e19a",
        "name": "NEXT: validate and deduplicate",
        "func": "let event = msg.payload;\nif (Buffer.isBuffer(event)) event = event.toString();\nif (typeof event === 'string') {\n    try { event = JSON.parse(event); } catch (_) { return null; }\n}\nif (!event || event.event !== 'NEXT' ||\n    typeof event.bootId !== 'string' || !/^[a-f0-9]{16}$/.test(event.bootId) ||\n    !Number.isSafeInteger(event.sequence) || event.sequence < 1 ||\n    event.sequence > 4294967295 || msg.retain === true) return null;\nconst seen = context.get('pageSequences') || {};\nconst previous = seen[event.bootId];\nif (previous !== undefined && event.sequence <= previous) return null;\nseen[event.bootId] = event.sequence;\nconst keys = Object.keys(seen);\nif (keys.length > 32) delete seen[keys[0]];\ncontext.set('pageSequences', seen);\nmsg.pageEvent = event;\nmsg.payload = 'NEXT';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
